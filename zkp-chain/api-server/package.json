    "elliptic": "^6.6.1",
    "express": "^4.18.2",
    "fabric-ca-client": "^2.2.4",
    "fabric-network": "^2.2.14",
    "ffjavascript": "^0.3.0",
    "form-data": "^4.0.0",
    "jimp": "^0.22.10",
    "jsqr": "^1.4.0",
